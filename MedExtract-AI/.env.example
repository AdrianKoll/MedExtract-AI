DJANGO_ENV=development
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# OCR externo opcional: registre uma chave gratuita no OCR.space.
OCR_SPACE_API_KEY=
OCR_API_URL=https://api.ocr.space/parse/image

# Transcrição externa opcional: token Hugging Face com permissão de inferência.
HF_TOKEN=
HF_AUDIO_API_URL=https://router.huggingface.co/hf-inference/models/openai/whisper-small
